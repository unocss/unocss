{
  "name": "@unocss/inspector",
  "type": "module",
  "version": "66.8.1",
  "description": "The inspector UI for UnoCSS",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://unocss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unocss/unocss.git",
    "directory": "packages-integrations/inspector"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "unocss",
    "inspector",
    "debugger"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./devframe": "./dist/devframe.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "prepack": "turbo build --filter=.",
    "build-post": "vite build",
    "dev": "tsdown --config-loader unrun --watch",
    "dev:client": "vite",
    "update-post": "vite build"
  },
  "dependencies": {
    "@devframes/service-shiki": "catalog:devtools",
    "@devframes/vite": "catalog:devtools",
    "@unocss/config": "workspace:*",
    "@unocss/core": "workspace:*",
    "@unocss/rule-utils": "workspace:*",
    "@vitejs/devtools-kit": "catalog:devtools",
    "colorette": "catalog:utils",
    "devframe": "catalog:devtools",
    "gzip-size": "catalog:build",
    "tinyglobby": "catalog:utils",
    "unplugin-utils": "catalog:utils"
  },
  "devDependencies": {
    "vue-flow-layout": "catalog:vue"
  }
}
