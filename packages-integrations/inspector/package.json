{
  "name": "@unocss/inspector",
  "type": "module",
  "version": "66.12.0",
  "description": "The inspector UI for UnoCSS",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://unocss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unocss/unocss.git",
    "directory": "packages-integrations/inspector"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "unocss",
    "inspector",
    "debugger"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./devframe": "./dist/devframe.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "prepack": "turbo build --filter=.",
    "build-post": "vite build",
    "dev": "tsdown --config-loader unrun --watch",
    "dev:client": "vite",
    "update-post": "vite build",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json"
  },
  "dependencies": {
    "@unocss/autocomplete": "workspace:*",
    "@unocss/config": "workspace:*",
    "@unocss/core": "workspace:*",
    "@unocss/preset-mini": "workspace:*",
    "@unocss/rule-utils": "workspace:*",
    "devframe": "catalog:devtools",
    "tinyglobby": "catalog:utils",
    "unplugin-utils": "catalog:utils"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "catalog:docs",
    "@codemirror/lang-css": "catalog:css",
    "@codemirror/lang-html": "catalog:docs",
    "@codemirror/lang-javascript": "catalog:docs",
    "@codemirror/lang-xml": "catalog:docs",
    "@codemirror/language": "catalog:docs",
    "@codemirror/state": "catalog:docs",
    "@codemirror/view": "catalog:docs",
    "@iconify-json/catppuccin": "catalog:icons",
    "@lezer/highlight": "catalog:docs",
    "@unocss/preset-attributify": "workspace:*",
    "@unocss/preset-icons": "workspace:*",
    "@unocss/preset-web-fonts": "workspace:*",
    "@unocss/preset-wind4": "workspace:*",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vueuse/core": "catalog:vue",
    "codemirror": "catalog:docs",
    "floating-vue": "catalog:vue",
    "shiki": "catalog:docs",
    "splitpanes": "catalog:utils",
    "unplugin-auto-import": "catalog:utils",
    "unplugin-vue-components": "catalog:vue",
    "vite-plugin-pages": "catalog:vite",
    "vue": "catalog:vue",
    "vue-clamp": "catalog:vue",
    "vue-flow-layout": "catalog:vue",
    "vue-router": "catalog:vue"
  }
}
