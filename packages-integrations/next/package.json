{
  "name": "@unocss/next",
  "type": "module",
  "version": "66.7.5",
  "description": "The Next.js plugin for UnoCSS",
  "author": "Kyle Zheng <kylezheng73@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://unocss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unocss/unocss.git",
    "directory": "packages-integrations/next"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "unocss",
    "nextjs",
    "turbopack"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./loader-css": {
      "import": "./dist/loader-css.mjs",
      "require": "./dist/loader-css.cjs"
    },
    "./loader-source": {
      "import": "./dist/loader-source.mjs",
      "require": "./dist/loader-source.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "dependencies": {
    "@unocss/config": "workspace:*",
    "@unocss/core": "workspace:*",
    "magic-string": "catalog:utils",
    "pathe": "catalog:utils",
    "tinyglobby": "catalog:utils"
  },
  "inlinedDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/resolve-uri": "3.1.2",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "picomatch": "4.0.4",
    "unplugin-utils": "0.3.1"
  }
}
