{
  "name": "@unocss/next",
  "type": "module",
  "version": "66.7.5",
  "description": "The Next.js plugin for UnoCSS",
  "author": "Kyle Zheng <kylezheng73@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://unocss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unocss/unocss.git",
    "directory": "packages-integrations/next"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "unocss",
    "nextjs",
    "turbopack"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./loader-css": {
      "import": "./dist/loader-css.mjs",
      "require": "./dist/loader-css.cjs"
    },
    "./loader-source": {
      "import": "./dist/loader-source.mjs",
      "require": "./dist/loader-source.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "dependencies": {
    "@jridgewell/remapping": "catalog:build",
    "@unocss/config": "workspace:*",
    "@unocss/core": "workspace:*",
    "magic-string": "catalog:utils",
    "pathe": "catalog:utils",
    "tinyglobby": "catalog:utils",
    "unplugin-utils": "catalog:utils"
  }
}
