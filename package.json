{
  "name": "@unocss/monorepo",
  "type": "module",
  "version": "66.12.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsx scripts/prepare.ts",
    "taze": "taze minor -wIr && pnpm -r --parallel run update-post",
    "bench": "npm -C bench run bench",
    "build": "turbo run build --filter='./packages-*/*'",
    "postbuild": "turbo run build-post --filter='@unocss/inspector' && tsx scripts/postbuild.ts",
    "dev": "turbo run dev --filter='./packages-*/*' --concurrency=50",
    "deploy": "nr build && npm -C docs run build && npm -C playground run build && npm -C interactive run build",
    "interactive": "npm -C interactive run dev",
    "docs": "npm -C docs run dev",
    "inspector": "npm -C packages-integrations/inspector run dev",
    "play": "npm -C playground run dev",
    "lint": "eslint --cache .",
    "lint:fix": "nr lint --fix",
    "release": "bumpp -r --excute=\"pnpm i\"",
    "size": "tsx scripts/size.ts",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.test.json && pnpm run typecheck:vue",
    "test": "vitest",
    "test:update": "vitest -u",
    "test:integration": "pnpm -F svelte-scoped test:integration",
    "test:ci": "nr build && nr typecheck && nr lint && nr test && nr test:integration",
    "check:attw": "pnpm -r --filter='./packages-*/*' --filter='!*vscode' exec attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "check:publint": "pnpm -r --filter='./packages-*/*' --filter='!*vscode' exec publint --strict",
    "update:iconify-collections": "tsx scripts/update-iconify-collections.ts",
    "typecheck:vue": "pnpm -r run typecheck:vue"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@arethetypeswrong/cli": "catalog:utils",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/logos": "catalog:icons",
    "@iconify-json/mdi": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/vscode-icons": "catalog:icons",
    "@oxc-parser/binding-wasm32-wasip1": "catalog:docs",
    "@types/css-tree": "catalog:types",
    "@types/node": "catalog:types",
    "@types/splitpanes": "catalog:types",
    "@typescript-eslint/rule-tester": "catalog:typescript",
    "@typescript/native-preview": "catalog:typescript",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vitest/ui": "catalog:testing",
    "bumpp": "catalog:build",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "eslint-plugin-format": "catalog:eslint",
    "eslint-vitest-rule-tester": "catalog:eslint",
    "jsdom": "catalog:testing",
    "lint-staged": "catalog:utils",
    "magic-string": "catalog:utils",
    "msw": "catalog:testing",
    "pathe": "catalog:utils",
    "pnpm": "catalog:utils",
    "postcss": "catalog:css",
    "prettier": "catalog:utils",
    "prettier-plugin-svelte": "catalog:svelte",
    "publint": "catalog:utils",
    "rolldown": "catalog:build",
    "rollup": "catalog:build",
    "simple-git-hooks": "catalog:utils",
    "svelte-eslint-parser": "catalog:eslint",
    "taze": "catalog:utils",
    "tinyexec": "catalog:utils",
    "tinyglobby": "catalog:utils",
    "tsdown": "catalog:build",
    "tsnapi": "catalog:build",
    "tsx": "catalog:typescript",
    "turbo": "catalog:build",
    "typescript": "catalog:typescript",
    "unrun": "catalog:utils",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue-tsc": "catalog:vue"
  },
  "resolutions": {
    "@typescript-eslint/utils": "catalog:typescript",
    "magic-string": "catalog:utils",
    "nuxt": "catalog:nuxt",
    "prettier": "catalog:utils",
    "rollup": "catalog:build",
    "vite": "catalog:vite"
  },
  "simple-git-hooks": {
    "pre-commit": "npx tsx scripts/prepare.ts && npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md}": [
      "eslint --cache --fix"
    ]
  }
}
